{
  "natural_language_enabled": {
    "type": "bool",
    "description": "自然语言查询",
    "hint": "开启后发送 /名剑 查梦江南的花间游排行。查询句子会交给所选模型识别。",
    "default": false
  },
  "natural_language_provider": {
    "type": "string",
    "description": "自然语言模型",
    "_special": "select_provider",
    "hint": "自然语言查询和 AI 锐评共用的对话模型。留空跟随当前会话模型。",
    "default": ""
  },
  "natural_language_timeout": {
    "type": "int",
    "description": "AI 响应超时（秒）",
    "hint": "自然语言查询和 AI 锐评等待模型的最长时间，填写 1–300 秒，默认 30 秒。",
    "obvious_hint": true,
    "default": 30
  },
  "natural_retry_enabled": {
    "type": "bool",
    "description": "模型漏调时补调",
    "hint": "模型第一次没有调用名剑工具时，再用强制工具调用补一次。关闭后直接走文本路由。",
    "default": true
  },
  "natural_retry_timeout": {
    "type": "int",
    "description": "补调等待（秒）",
    "hint": "补调和文本路由最多等待模型的时间，填写 1–60 秒，默认 10 秒。",
    "default": 10
  },
  "natural_text_route_enabled": {
    "type": "bool",
    "description": "文本路由兜底",
    "hint": "工具补调失败后，让模型用普通文本输出动作和参数再识别一次。",
    "default": true
  },
  "natural_cooldown": {
    "type": "int",
    "description": "同一用户查询间隔（秒）",
    "hint": "同一用户连续查询的最短间隔，填写 0–60 秒，0 表示不限制，默认 2 秒。",
    "default": 2
  },
  "review_enabled": {
    "type": "bool",
    "description": "AI 锐评",
    "hint": "开启后，在战绩、对局、回放、复盘或角色总览下回复 AI 锐评的序号。",
    "default": false
  },
  "review_persona": {
    "type": "string",
    "description": "锐评人格",
    "_special": "select_persona",
    "hint": "选择 AstrBot 已保存的人格，使用其提示词决定锐评语气。",
    "default": ""
  },
  "role_nicknames": {
    "type": "template_list",
    "description": "角色昵称",
    "hint": "每组可填写多个昵称和多个角色。组内每个昵称都对应这一组的全部角色。",
    "default": [],
    "templates": {
      "group": {
        "name": "昵称与角色组",
        "display_item": "nicknames",
        "items": {
          "nicknames": {"type": "text", "description": "昵称（每行一个）", "default": ""},
          "roles": {
            "type": "template_list",
            "description": "角色",
            "default": [],
            "templates": {
              "role": {
                "name": "区服与角色",
                "display_item": "name",
                "items": {
                  "server": {"type": "string", "description": "区服", "default": ""},
                  "name": {"type": "string", "description": "角色名", "default": ""}
                }
              }
            }
          }
        }
      },
      "link": {
        "name": "旧版单条关联",
        "display_item": "nickname",
        "items": {
          "nickname": {"type": "string", "description": "昵称", "default": ""},
          "server": {"type": "string", "description": "区服", "default": ""},
          "name": {"type": "string", "description": "角色名", "default": ""}
        }
      }
    }
  },
  "heart_aliases": {
    "type": "template_list",
    "description": "心法别名",
    "hint": "为同一个心法添加一个或多个叫法，可用于排行、奇穴、门派资料和配置查询。",
    "obvious_hint": true,
    "default": [],
    "templates": {
      "rule": {
        "name": "心法映射",
        "display_item": "target",
        "items": {
          "target": {
            "type": "string",
            "description": "心法全名",
            "hint": "填写原站心法全名，例如花间游或离经易道。",
            "default": ""
          },
          "aliases": {
            "type": "text",
            "description": "别名",
            "hint": "用换行、空格或逗号分隔，例如花花，万花DPS。每个别名只能指向一个心法。",
            "default": ""
          }
        }
      }
    }
  },
  "server_aliases": {
    "type": "template_list",
    "description": "服务器别名",
    "hint": "为同一个服务器添加一个或多个叫法，可用于排行和角色查询。",
    "obvious_hint": true,
    "default": [],
    "templates": {
      "rule": {
        "name": "服务器映射",
        "display_item": "target",
        "items": {
          "target": {
            "type": "string",
            "description": "原站服务器名",
            "hint": "填写原站服务器名，例如梦江南。",
            "default": ""
          },
          "aliases": {
            "type": "text",
            "description": "别名",
            "hint": "用换行、空格或逗号分隔，例如梦服，江南。每个别名只能指向一个服务器。",
            "default": ""
          }
        }
      }
    }
  }
}
